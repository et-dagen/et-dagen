{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --dotenv .env.development",
    "start": "node .output/server/index.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "bun --bun nuxt prepare",
    "lint:js": "eslint --ext \".ts,.vue,.js,.cjs,.mjs,.yml,\" --ignore-path .gitignore .",
    "lint:prettier": "prettier --check .",
    "lint": "bun run lint:js && bun run lint:prettier",
    "lintfix": "bun run lint:prettier && bun run lint:js --fix",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:full": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,vue,css,scss,md,yml}": [
      "prettier --write"
    ],
    "*.{js,ts,vue}": [
      "eslint --fix"
    ]
  },
  "overrides": {
    "oxc-parser": "0.132.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@nuxt/devtools": "^3.3.1",
    "@nuxtjs/eslint-config-typescript": "^12.1.0",
    "@nuxtjs/i18n": "^9.1.5",
    "@types/node": "^22.13.0",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/parser": "^5.62.0",
    "@vueuse/core": "^10.11.1",
    "@vueuse/nuxt": "^10.11.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "nuxt": "^3.15.4",
    "prettier": "^3.4.2",
    "sass": "^1.83.4",
    "typescript": "^5.7.3",
    "vitest": "^3",
    "vue-tsc": "^3.3.9"
  },
  "dependencies": {
    "@intlify/core-base": "^10.0.5",
    "@intlify/message-compiler": "^10.0.5",
    "@intlify/shared": "^10.0.5",
    "@nuxt/image": "^1.9.0",
    "@pinia/nuxt": "^0.9.0",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "@tiptap/vue-3": "^2.11.5",
    "dotenv": "^16.4.7",
    "firebase": "^11.2.0",
    "firebase-admin": "^13.0.2",
    "jsqr": "^1.4.0",
    "pinia": "^2.3.1",
    "qrcode": "^1.5.4",
    "sass-migrator": "^2.3.1",
    "vuetify": "^3.7.9",
    "vuetify-nuxt-module": "^0.18.3"
  }
}
